# Cache de Netlify. Sin este archivo todo se sirve con max-age=0 y cada
# visita revalida los ~30 archivos del sitio, uno por uno, en redes móviles.
# Las fotos cambian solo de nombre y la CSS va versionada con ?v=, así que
# assets y css pueden cachearse un año como inmutables. El HTML queda con el
# default de Netlify (revalidar siempre), que es lo que corresponde.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable
